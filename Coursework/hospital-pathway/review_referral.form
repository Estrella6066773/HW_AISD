{
  "components": [
    {
      "id": "Text_Title",
      "type": "text",
      "text": "## P2 — Consultant referral review\n\n_Demo only._",
      "layout": {
        "row": "Row_Title",
        "columns": null
      }
    },
    {
      "id": "Field_patientId",
      "type": "textfield",
      "key": "patientId",
      "label": "Patient / case ID",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "id": "Field_clinicianId",
      "type": "textfield",
      "key": "clinicianId",
      "label": "Clinician ID / name",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_1",
        "columns": null
      }
    },
    {
      "id": "Field_action",
      "type": "select",
      "key": "action",
      "label": "Referral decision",
      "values": [
        {
          "label": "Accept",
          "value": "accept"
        },
        {
          "label": "Reject",
          "value": "reject"
        },
        {
          "label": "Redirect to another specialty",
          "value": "redirect"
        },
        {
          "label": "Request more information",
          "value": "more_information"
        }
      ],
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_2",
        "columns": null
      }
    },
    {
      "id": "Field_decisionReason",
      "type": "textarea",
      "key": "decisionReason",
      "label": "Decision reason",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_3",
        "columns": null
      }
    },
    {
      "id": "Field_notes",
      "type": "textarea",
      "key": "notes",
      "label": "Additional notes",
      "validate": {
        "required": false
      },
      "layout": {
        "row": "Row_4",
        "columns": null
      }
    },
    {
      "id": "Button_Submit",
      "type": "button",
      "label": "Record decision",
      "action": "submit",
      "layout": {
        "row": "Row_Submit",
        "columns": null
      }
    }
  ],
  "type": "default",
  "id": "review_referral",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  },
  "schemaVersion": 19
}
