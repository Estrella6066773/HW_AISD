{
  "components": [
    {
      "id": "Text_Title",
      "type": "text",
      "text": "## P7 / P11 / P12 — Finance adjustment\n\nChoose the decision itself. Refund, transfer and retained fee are different outcomes. Pending stays on this task. The original charge is shown for comparison. A partial refund must be lower than that charge.\n\n_Demo only. No card data._",
      "layout": {
        "row": "Row_Title",
        "columns": null
      }
    },
    {
      "id": "Field_patientId",
      "type": "textfield",
      "key": "patientId",
      "label": "Patient / case ID",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "id": "Field_staffRole",
      "type": "textfield",
      "key": "staffRole",
      "label": "Finance staff name and role",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_1",
        "columns": null
      }
    },
    {
      "id": "Field_action",
      "type": "select",
      "key": "action",
      "label": "Outcome / next action",
      "values": [
        {
          "label": "Full refund",
          "value": "refund_full"
        },
        {
          "label": "Partial refund",
          "value": "refund_partial"
        },
        {
          "label": "Transfer the payment to another appointment",
          "value": "transfer"
        },
        {
          "label": "Retain the fee",
          "value": "retain"
        },
        {
          "label": "Provider result still pending",
          "value": "pending"
        }
      ],
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_2",
        "columns": null
      }
    },
    {
      "id": "Field_charge_amount",
      "type": "textfield",
      "key": "charge_amount",
      "label": "Original charge",
      "readonly": true,
      "description": "Taken from the funding step on the V2 pathway. This field is not edited here. Leave it blank when no charge has been recorded yet.",
      "layout": {
        "row": "Row_charge",
        "columns": null
      }
    },
    {
      "id": "Field_adjustmentAmount",
      "type": "number",
      "key": "adjustmentAmount",
      "label": "Adjustment amount",
      "decimalDigits": 2,
      "increment": "0.01",
      "serializeToString": true,
      "validate": {
        "required": true,
        "min": 0.01,
        "max": 99999.99
      },
      "description": "Two decimal places. A partial refund must be lower than the original charge.",
      "conditional": {
        "hide": "=action = \"pending\""
      },
      "layout": {
        "row": "Row_amount",
        "columns": null
      }
    },
    {
      "id": "Field_notes",
      "type": "textarea",
      "key": "notes",
      "label": "Reason for this decision",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_3",
        "columns": null
      }
    },
    {
      "id": "Button_Submit",
      "type": "button",
      "label": "Complete task",
      "action": "submit",
      "layout": {
        "row": "Row_Submit",
        "columns": null
      }
    }
  ],
  "type": "default",
  "id": "finance_adjustment",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  },
  "schemaVersion": 19
}
