      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_42</bpmn:outgoing>
      <bpmn:outgoing>Flow_43</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Funding" name="P7&#10;Assess funding; record&#10;payment / approval status">
      <bpmn:documentation>Finance: establish hospital, insurer or patient funding before confirming treatment. Record insurer reference, amount and restrictions, or payment provider transaction reference/date/amount. Never store full card details. Advance payment needs verified success or an authorised funding/exemption/arrangement. Provider success with missing confirmation requires investigation, never an automatic second charge. This task only records simulated provider outcomes.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="hospital_task_form" bindingType="deployment" />
        <zeebe:assignmentDefinition assignee="demo" />
        <zeebe:ioMapping>
          <zeebe:input source="= &#34;P7 Assess funding; record payment / approval status&#34;" target="taskTitle" />
          <zeebe:input source="= &#34;Finance: establish hospital, insurer or patient funding before confirming treatment. Record insurer reference, amount and restrictions, or payment provider transaction reference/date/amount. Never store full card details. Advance payment needs verified success or an authorised funding/exemption/arrangement. Provider success with missing confirmation requires investigation, never an automatic second charge. This task only records simulated provider outcomes.&#34;" target="taskHelp" />
          <zeebe:input source="= &#34;Funding&#34;" target="taskCode" />
          <zeebe:input source="= [{ label: &#34;Hospital funding confirmed&#34;, value: &#34;hospital_funded&#34; }, { label: &#34;Insurer approval recorded&#34;, value: &#34;insurer_approved&#34; }, { label: &#34;Payment verified&#34;, value: &#34;patient_paid&#34; }, { label: &#34;Authorised exemption / payment arrangement&#34;, value: &#34;arrangement&#34; }, { label: &#34;Declined / incomplete / funding pending&#34;, value: &#34;pending&#34; }, { label: &#34;Provider success but confirmation missing&#34;, value: &#34;investigate&#34; }, { label: &#34;Request clinical review of urgent-care exception&#34;, value: &#34;urgent_review&#34; }]" target="actionOptions" />
          <zeebe:input source="= null" target="action" />
          <zeebe:input source="= &#34;&#34;" target="notes" />
          <zeebe:input source="= if is defined(patientId) then patientId else &#34;&#34;" target="patientId" />
          <zeebe:output source="= patientId" target="patientId" />
          <zeebe:output source="= notes" target="FundingNotes" />
          <zeebe:output source="= action" target="fundingStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_46</bpmn:incoming>
      <bpmn:incoming>Flow_49</bpmn:incoming>
      <bpmn:incoming>Flow_59</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
