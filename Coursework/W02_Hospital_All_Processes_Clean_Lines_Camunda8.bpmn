    </bpmn:exclusiveGateway>
    <bpmn:userTask id="FundingIssue" name="P7&#10;Resolve funding issue /&#10;investigate missing receipt">
      <bpmn:documentation>Notify patient and booking team of failed, incomplete or duplicated payments. Check existing transaction before retrying, and avoid duplicate charges/bookings. Where the provider may already have taken payment, investigate/reconcile first; never request payment automatically. Record result before reassessing funding.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="hospital_task_form" bindingType="deployment" />
        <zeebe:assignmentDefinition assignee="demo" />
        <zeebe:ioMapping>
          <zeebe:input source="= &#34;P7 Resolve funding issue / investigate missing receipt&#34;" target="taskTitle" />
          <zeebe:input source="= &#34;Notify patient and booking team of failed, incomplete or duplicated payments. Check existing transaction before retrying, and avoid duplicate charges/bookings. Where the provider may already have taken payment, investigate/reconcile first; never request payment automatically. Record result before reassessing funding.&#34;" target="taskHelp" />
          <zeebe:input source="= &#34;FundingIssue&#34;" target="taskCode" />
          <zeebe:input source="= [{ label: &#34;Completed and recorded&#34;, value: &#34;recorded&#34; }]" target="actionOptions" />
          <zeebe:input source="= null" target="action" />
          <zeebe:input source="= &#34;&#34;" target="notes" />
          <zeebe:input source="= if is defined(patientId) then patientId else &#34;&#34;" target="patientId" />
          <zeebe:output source="= patientId" target="patientId" />
          <zeebe:output source="= notes" target="FundingIssueNotes" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_45</bpmn:incoming>
      <bpmn:outgoing>Flow_46</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UrgentAuthorisation" name="P8&#10;Clinician authorises&#10;urgent care with reason">
      <bpmn:documentation>Only a clinician may authorise treatment before confirmed payment where delay risks the patient. Record clinician identity, clinical reason and the decision, and create a Finance follow-up obligation. Finance can request this review but cannot approve the clinical exception.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="hospital_task_form" bindingType="deployment" />
        <zeebe:assignmentDefinition assignee="demo" />
        <zeebe:ioMapping>
          <zeebe:input source="= &#34;P8 Clinician authorises urgent care with reason&#34;" target="taskTitle" />
          <zeebe:input source="= &#34;Only a clinician may authorise treatment before confirmed payment where delay risks the patient. Record clinician identity, clinical reason and the decision, and create a Finance follow-up obligation. Finance can request this review but cannot approve the clinical exception.&#34;" target="taskHelp" />
          <zeebe:input source="= &#34;UrgentAuthorisation&#34;" target="taskCode" />
          <zeebe:input source="= [{ label: &#34;Authorise urgent care and record reason&#34;, value: &#34;authorise&#34; }, { label: &#34;Not authorised - continue finance resolution&#34;, value: &#34;hold&#34; }]" target="actionOptions" />
          <zeebe:input source="= null" target="action" />
          <zeebe:input source="= &#34;&#34;" target="notes" />
          <zeebe:input source="= if is defined(patientId) then patientId else &#34;&#34;" target="patientId" />
          <zeebe:output source="= patientId" target="patientId" />
          <zeebe:output source="= notes" target="UrgentAuthorisationNotes" />
          <zeebe:output source="= action" target="urgentDecision" />
          <zeebe:output source="= action = &#34;authorise&#34;" target="urgentCase" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_44</bpmn:incoming>
      <bpmn:outgoing>Flow_47</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="UrgentDecision" name="Urgent care&#10;authorised?" default="Flow_49">
      <bpmn:incoming>Flow_47</bpmn:incoming>
      <bpmn:outgoing>Flow_48</bpmn:outgoing>
      <bpmn:outgoing>Flow_49</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="BookTreatment" name="P6&#10;Confirm authorised treatment&#10;and investigation appointments">
      <bpmn:documentation>Treatment / Chemotherapy Bookings: use the authorised clinical request and confirmed funding or documented urgent exception. Coordinate cycles, resources, laboratory/imaging and external services. If unavailable, keep pending, notify responsible staff and log retry attempts without duplicate appointments. Confirm and notify patient only after these checks. Classroom task records external outcomes.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="hospital_task_form" bindingType="deployment" />
