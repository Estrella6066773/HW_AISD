          <zeebe:input source="= &#34;After clinician-authorised urgent treatment, Finance records subsequent payment/funding investigation, responsible owner and next action. Clinical urgency does not waive the financial obligation. An unresolved balance remains visible in reports even if the clinical episode ends.&#34;" target="taskHelp" />
          <zeebe:input source="= &#34;UrgentFinance&#34;" target="taskCode" />
          <zeebe:input source="= [{ label: &#34;Completed and recorded&#34;, value: &#34;recorded&#34; }]" target="actionOptions" />
          <zeebe:input source="= null" target="action" />
          <zeebe:input source="= &#34;&#34;" target="notes" />
          <zeebe:input source="= if is defined(patientId) then patientId else &#34;&#34;" target="patientId" />
          <zeebe:output source="= patientId" target="patientId" />
          <zeebe:output source="= notes" target="UrgentFinanceNotes" />
          <zeebe:output source="= false" target="urgentCase" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_37</bpmn:incoming>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
