          <zeebe:input source="= &#34;P6 Confirm authorised treatment and investigation appointments&#34;" target="taskTitle" />
          <zeebe:input source="= &#34;Treatment / Chemotherapy Bookings: use the authorised clinical request and confirmed funding or documented urgent exception. Coordinate cycles, resources, laboratory/imaging and external services. If unavailable, keep pending, notify responsible staff and log retry attempts without duplicate appointments. Confirm and notify patient only after these checks. Classroom task records external outcomes.&#34;" target="taskHelp" />
          <zeebe:input source="= &#34;BookTreatment&#34;" target="taskCode" />
          <zeebe:input source="= [{ label: &#34;Resources available; booking confirmed&#34;, value: &#34;ready&#34; }, { label: &#34;External service / resource unavailable&#34;, value: &#34;pending&#34; }]" target="actionOptions" />
          <zeebe:input source="= null" target="action" />
          <zeebe:input source="= &#34;&#34;" target="notes" />
          <zeebe:input source="= if is defined(patientId) then patientId else &#34;&#34;" target="patientId" />
          <zeebe:output source="= patientId" target="patientId" />
          <zeebe:output source="= notes" target="BookTreatmentNotes" />
          <zeebe:output source="= action" target="treatmentSlotStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
