<bpmndi:BPMNShape id="RecordPayment_di" bpmnElement="RecordPayment"><dc:Bounds x="1130" y="600" width="150" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="PaymentSucceeded_di" bpmnElement="PaymentSucceeded" isMarkerVisible="true"><dc:Bounds x="1365" y="615" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1423" y="620" width="105" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="FollowUp_di" bpmnElement="FollowUp"><dc:Bounds x="1210" y="730" width="150" height="70" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Pending_di" bpmnElement="Pending"><dc:Bounds x="1096" y="747" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1060" y="785" width="110" height="34" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ConfirmBooking_di" bpmnElement="ConfirmBooking"><dc:Bounds x="1030" y="370" width="170" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="NotifyPatient_di" bpmnElement="NotifyPatient"><dc:Bounds x="1260" y="370" width="160" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Booked_di" bpmnElement="Booked"><dc:Bounds x="1475" y="392" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1448" y="438" width="92" height="34" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
