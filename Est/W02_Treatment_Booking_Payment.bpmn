<bpmndi:BPMNEdge id="TF11_di" bpmnElement="TF11"><di:waypoint x="1390" y="665" /><di:waypoint x="1390" y="765" /><di:waypoint x="1360" y="765" /><bpmndi:BPMNLabel><dc:Bounds x="1400" y="700" width="32" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
