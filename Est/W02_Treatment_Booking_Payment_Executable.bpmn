<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Treatment_Executable" targetNamespace="http://example.com/aisd/week2" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_Treatment">
    <bpmn:participant id="Hospital" name="Hospital - Treatment Booking and Payment" processRef="TreatmentProcess" />
    <bpmn:participant id="Participant_0l8t3ch" name="payment service system" />
    <bpmn:messageFlow id="Flow_1brlb7r" sourceRef="RequestPayment" targetRef="Participant_0l8t3ch" />
    <bpmn:messageFlow id="Flow_0f0wvyo" sourceRef="Participant_0l8t3ch" targetRef="PaymentReceived" />
  </bpmn:collaboration>
  <bpmn:process id="TreatmentProcess" name="Treatment Booking and Payment" isExecutable="true">
    <bpmn:documentation>Executable copy of Est/W02_Treatment_Booking_Payment.bpmn. Job types, the payment-result message and gateway conditions follow Est/est：治疗预约与付款活动设计.md and Est/est：治疗预约与付款流程变量设计.md. User tasks carry form-id placeholders until forms are created. The concept diagram file is unchanged.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_Treatment">
      <bpmn:lane id="Lane_Finance" name="Finance Team">
        <bpmn:flowNodeRef>CheckFunding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PaymentRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RequestPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PaymentReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RecordPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PaymentSucceeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FollowUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pending</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bookings" name="Treatment Bookings Team">
        <bpmn:flowNodeRef>PrepareBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConfirmBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotifyPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Booked</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Clinical" name="Consultant">
        <bpmn:flowNodeRef>TreatmentAgreed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AuthoriseTreatment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="TreatmentAgreed" name="Treatment&#10;agreed">
      <bpmn:outgoing>TF1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="AuthoriseTreatment" name="Record consent and&#10;authorise treatment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="AuthoriseTreatmentForm" />
        <zeebe:assignmentDefinition assignee="demo" />
      </bpmn:extensionElements>
      <bpmn:incoming>TF1</bpmn:incoming>
      <bpmn:outgoing>TF2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PrepareBooking" name="Prepare provisional&#10;booking">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="PrepareBookingForm" />
        <zeebe:assignmentDefinition assignee="demo" />
      </bpmn:extensionElements>
      <bpmn:incoming>TF2</bpmn:incoming>
      <bpmn:outgoing>TF3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="CheckFunding" name="Check charge&#10;and funding">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="CheckFundingForm" />
        <zeebe:assignmentDefinition assignee="demo" />
      </bpmn:extensionElements>
      <bpmn:incoming>TF3</bpmn:incoming>
      <bpmn:outgoing>TF4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PaymentRequired" name="Patient payment&#10;required?" default="TF6">
      <bpmn:incoming>TF4</bpmn:incoming>
      <bpmn:outgoing>TF5</bpmn:outgoing>
      <bpmn:outgoing>TF6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="RequestPayment" name="Send payment&#10;request">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-payment" />
      </bpmn:extensionElements>
      <bpmn:incoming>TF5</bpmn:incoming>
      <bpmn:outgoing>TF7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="PaymentReceived" name="Payment result&#10;received">
      <bpmn:incoming>TF7</bpmn:incoming>
      <bpmn:outgoing>TF8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="PaymentMessageDefinition" messageRef="Message_PaymentResult" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="RecordPayment" name="Record payment&#10;result">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="RecordPaymentForm" />
        <zeebe:assignmentDefinition assignee="demo" />
      </bpmn:extensionElements>
      <bpmn:incoming>TF8</bpmn:incoming>
      <bpmn:outgoing>TF9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PaymentSucceeded" name="Payment&#10;successful?" default="TF11">
      <bpmn:incoming>TF9</bpmn:incoming>
      <bpmn:outgoing>TF10</bpmn:outgoing>
      <bpmn:outgoing>TF11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ConfirmBooking" name="Confirm treatment&#10;booking">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="ConfirmBookingForm" />
        <zeebe:assignmentDefinition assignee="demo" />
      </bpmn:extensionElements>
      <bpmn:incoming>TF6</bpmn:incoming>
      <bpmn:incoming>TF10</bpmn:incoming>
      <bpmn:outgoing>TF13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="NotifyPatient" name="Send booking&#10;confirmation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-booking-confirmation" />
      </bpmn:extensionElements>
      <bpmn:incoming>TF13</bpmn:incoming>
      <bpmn:outgoing>TF14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Booked" name="Booking&#10;confirmed">
      <bpmn:incoming>TF14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="TF1" sourceRef="TreatmentAgreed" targetRef="AuthoriseTreatment" />
    <bpmn:sequenceFlow id="TF2" sourceRef="AuthoriseTreatment" targetRef="PrepareBooking" />
    <bpmn:sequenceFlow id="TF3" sourceRef="PrepareBooking" targetRef="CheckFunding" />
    <bpmn:sequenceFlow id="TF4" sourceRef="CheckFunding" targetRef="PaymentRequired" />
    <bpmn:sequenceFlow id="TF5" name="Yes" sourceRef="PaymentRequired" targetRef="RequestPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=patient_payment_required = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="TF6" name="No" sourceRef="PaymentRequired" targetRef="ConfirmBooking" />
    <bpmn:sequenceFlow id="TF7" sourceRef="RequestPayment" targetRef="PaymentReceived" />
    <bpmn:sequenceFlow id="TF8" sourceRef="PaymentReceived" targetRef="RecordPayment" />
    <bpmn:sequenceFlow id="TF9" sourceRef="RecordPayment" targetRef="PaymentSucceeded" />
    <bpmn:sequenceFlow id="TF10" name="Yes" sourceRef="PaymentSucceeded" targetRef="ConfirmBooking">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=payment_status = "successful"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="TF11" name="No" sourceRef="PaymentSucceeded" targetRef="FollowUp" />
    <bpmn:sequenceFlow id="TF12" sourceRef="FollowUp" targetRef="Pending" />
    <bpmn:sequenceFlow id="TF13" sourceRef="ConfirmBooking" targetRef="NotifyPatient" />
    <bpmn:sequenceFlow id="TF14" sourceRef="NotifyPatient" targetRef="Booked" />
    <bpmn:userTask id="FollowUp" name="Keep pending&#10;and follow up">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="FollowUpForm" />
        <zeebe:assignmentDefinition assignee="demo" />
      </bpmn:extensionElements>
      <bpmn:incoming>TF11</bpmn:incoming>
      <bpmn:outgoing>TF12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Pending" name="Pending&#10;resolution">
      <bpmn:incoming>TF12</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:message id="Message_PaymentResult" name="payment-result">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=case_reference" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="Diagram_Treatment">
    <bpmndi:BPMNPlane id="Plane_Treatment" bpmnElement="Collaboration_Treatment">
      <bpmndi:BPMNShape id="Hospital_di" bpmnElement="Hospital" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1698" height="690" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Finance_di" bpmnElement="Lane_Finance" isHorizontal="true">
        <dc:Bounds x="150" y="460" width="1668" height="310" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Bookings_di" bpmnElement="Lane_Bookings" isHorizontal="true">
        <dc:Bounds x="150" y="240" width="1668" height="220" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Clinical_di" bpmnElement="Lane_Clinical" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1668" height="160" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TreatmentAgreed_di" bpmnElement="TreatmentAgreed">
        <dc:Bounds x="220" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="213" y="185" width="50" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AuthoriseTreatment_di" bpmnElement="AuthoriseTreatment">
        <dc:Bounds x="320" y="120" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PrepareBooking_di" bpmnElement="PrepareBooking">
        <dc:Bounds x="510" y="310" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckFunding_di" bpmnElement="CheckFunding">
        <dc:Bounds x="510" y="540" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentRequired_di" bpmnElement="PaymentRequired" isMarkerVisible="true">
        <dc:Bounds x="720" y="555" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="705" y="620" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RequestPayment_di" bpmnElement="RequestPayment">
        <dc:Bounds x="825" y="540" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentReceived_di" bpmnElement="PaymentReceived">
        <dc:Bounds x="1032" y="562" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1013" y="524.5" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RecordPayment_di" bpmnElement="RecordPayment">
        <dc:Bounds x="1130" y="540" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentSucceeded_di" bpmnElement="PaymentSucceeded" isMarkerVisible="true">
        <dc:Bounds x="1365" y="555" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1447" y="560" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ConfirmBooking_di" bpmnElement="ConfirmBooking">
        <dc:Bounds x="1030" y="310" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotifyPatient_di" bpmnElement="NotifyPatient">
        <dc:Bounds x="1260" y="310" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Booked_di" bpmnElement="Booked">
        <dc:Bounds x="1475" y="332" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1470" y="378" width="49" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FollowUp_di" bpmnElement="FollowUp">
        <dc:Bounds x="1445" y="670" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pending_di" bpmnElement="Pending">
        <dc:Bounds x="1682" y="687" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1677" y="725" width="48" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="TF1_di" bpmnElement="TF1">
        <di:waypoint x="256" y="160" />
        <di:waypoint x="320" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="TF2_di" bpmnElement="TF2">
        <di:waypoint x="480" y="160" />
        <di:waypoint x="585" y="160" />
        <di:waypoint x="585" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="TF3_di" bpmnElement="TF3">
        <di:waypoint x="585" y="390" />
        <di:waypoint x="585" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="TF4_di" bpmnElement="TF4">
        <di:waypoint x="660" y="580" />
