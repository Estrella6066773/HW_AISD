<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.5</version>
		<relativePath />
	</parent>
	<groupId>io.camunda.demo</groupId>
	<artifactId>hospital-pathway-zh-learn</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Hospital Pathway (中文学习副本)</name>
	<description>中文学习/自测副本（可删）。显示文字已汉化；网关取值仍为英文以保证可运行。</description>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>
		<dependency>
			<groupId>io.camunda</groupId>
			<artifactId>camunda-spring-boot-starter</artifactId>
			<version>8.9.0</version>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<!-- Source assets live in bpmn/ and forms/; packaged to classpath for deploy. -->
			<resource>
				<directory>${project.basedir}/bpmn</directory>
				<includes>
					<include>*.bpmn</include>
				</includes>
				<targetPath>bpmn</targetPath>
			</resource>
			<resource>
				<directory>${project.basedir}/forms</directory>
				<includes>
					<include>*.form</include>
				</includes>
				<targetPath>forms</targetPath>
			</resource>
		</resources>
	</build>
</project>
