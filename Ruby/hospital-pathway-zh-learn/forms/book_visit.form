{
  "components": [
    {
      "id": "Text_Title",
      "type": "text",
      "text": "## P3 / P4 / P12 — 预约就诊\n\n_演示用。_",
      "layout": {
        "row": "Row_Title",
        "columns": null
      }
    },
    {
      "id": "Field_patientId",
      "type": "textfield",
      "key": "patientId",
      "label": "患者 / 病例编号",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "id": "Field_staffRole",
      "type": "textfield",
      "key": "staffRole",
      "label": "人员姓名与角色",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_1",
        "columns": null
      }
    },
    {
      "id": "Field_action",
      "type": "select",
      "key": "action",
      "label": "结果 / 下一步",
      "values": [
        {
          "label": "已预约、通知且已到诊",
          "value": "attended"
        },
        {
          "label": "无合适号源 / 联系或服务待定",
          "value": "pending"
        },
        {
          "label": "已取消 / 拒绝 / 未到诊",
          "value": "cancelled"
        }
      ],
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_2",
        "columns": null
      }
    },
    {
      "id": "Field_notes",
      "type": "textarea",
      "key": "notes",
      "label": "预约 / 联系备注",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_3",
        "columns": null
      }
    },
    {
      "id": "Button_Submit",
      "type": "button",
      "label": "完成任务",
      "action": "submit",
      "layout": {
        "row": "Row_Submit",
        "columns": null
      }
    }
  ],
  "type": "default",
  "id": "book_visit",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  },
  "schemaVersion": 19
}
