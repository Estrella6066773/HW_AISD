{
  "components": [
    {
      "id": "Text_Title",
      "type": "text",
      "text": "## P6 — 确认治疗预约\n\n选择 **资源可用** 会触发 Java `send-booking-confirmation`。\n\n_演示用。_",
      "layout": {
        "row": "Row_Title",
        "columns": null
      }
    },
    {
      "id": "Field_patientId",
      "type": "textfield",
      "key": "patientId",
      "label": "患者 / 病例编号",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "id": "Field_staffRole",
      "type": "textfield",
      "key": "staffRole",
      "label": "人员姓名与角色",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_1",
        "columns": null
      }
    },
    {
      "id": "Field_action",
      "type": "select",
      "key": "action",
      "label": "结果 / 下一步",
      "values": [
        {
          "label": "资源可用；预约已确认",
          "value": "ready"
        },
        {
          "label": "外部服务 / 资源不可用",
          "value": "pending"
        }
      ],
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_2",
        "columns": null
      }
    },
    {
      "id": "Field_notes",
      "type": "textarea",
      "key": "notes",
      "label": "预约备注",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_3",
        "columns": null
      }
    },
    {
      "id": "Button_Submit",
      "type": "button",
      "label": "完成预约核验",
      "action": "submit",
      "layout": {
        "row": "Row_Submit",
        "columns": null
      }
    }
  ],
  "type": "default",
  "id": "book_treatment",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  },
  "schemaVersion": 19
}
