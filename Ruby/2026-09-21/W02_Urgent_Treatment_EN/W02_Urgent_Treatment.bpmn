<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_UrgentTreatmentEn" targetNamespace="http://aisd.example/student/p8" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="P8_UrgentTreatmentEn" name="P8 - Urgent Treatment Without Confirmed Payment" isExecutable="true">
    <bpmn:startEvent id="Start_Unconfirmed" name="Payment unconfirmed">
      <bpmn:outgoing>Flow_ToAssess</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_AssessRisk" name="Assess risk of delaying treatment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_AssessDelayRisk" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAssess</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Risk" name="Delay risks patient safety?">
      <bpmn:incoming>Flow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Authorise" name="Authorise urgent care and record reason">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_AuthoriseUrgentCare" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_ToInform</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_InformPatient" name="Inform patient about urgent treatment">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToInform</bpmn:incoming>
      <bpmn:outgoing>Flow_ToStartCare</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_StartCare" name="Start urgent treatment">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToStartCare</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReview</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReviewFinance" name="Review outstanding funding / payment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_ReviewFinance" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRecord</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_RecordFinance" name="Record follow-up and next action">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRecord</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFollowUpEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_FollowUp" name="Finance follow-up recorded">
      <bpmn:incoming>Flow_ToFollowUpEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_NormalPayment" name="Return to normal funding and payment (P7)">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_No</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNormalEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Normal" name="Normal payment pathway">
      <bpmn:incoming>Flow_ToNormalEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToAssess" sourceRef="Start_Unconfirmed" targetRef="Task_AssessRisk" />
    <bpmn:sequenceFlow id="Flow_ToGateway" sourceRef="Task_AssessRisk" targetRef="Gateway_Risk" />
    <bpmn:sequenceFlow id="Flow_Yes" name="Yes" sourceRef="Gateway_Risk" targetRef="Task_Authorise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=delayRisksSafety = "Yes"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToInform" sourceRef="Task_Authorise" targetRef="Task_InformPatient" />
    <bpmn:sequenceFlow id="Flow_ToStartCare" sourceRef="Task_InformPatient" targetRef="Task_StartCare" />
    <bpmn:sequenceFlow id="Flow_ToReview" sourceRef="Task_StartCare" targetRef="Task_ReviewFinance" />
    <bpmn:sequenceFlow id="Flow_ToRecord" sourceRef="Task_ReviewFinance" targetRef="Task_RecordFinance" />
    <bpmn:sequenceFlow id="Flow_ToFollowUpEnd" sourceRef="Task_RecordFinance" targetRef="End_FollowUp" />
    <bpmn:sequenceFlow id="Flow_No" name="No" sourceRef="Gateway_Risk" targetRef="Task_NormalPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=delayRisksSafety = "No"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToNormalEnd" sourceRef="Task_NormalPayment" targetRef="End_Normal" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_UrgentTreatmentEn">
    <bpmndi:BPMNPlane id="Plane_UrgentTreatmentEn" bpmnElement="P8_UrgentTreatmentEn">
      <bpmndi:BPMNShape id="Start_Unconfirmed_di" bpmnElement="Start_Unconfirmed">
        <dc:Bounds x="160" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="136" y="245" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AssessRisk_di" bpmnElement="Task_AssessRisk">
        <dc:Bounds x="260" y="180" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Risk_di" bpmnElement="Gateway_Risk" isMarkerVisible="true">
        <dc:Bounds x="505" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="486" y="252" width="88" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Authorise_di" bpmnElement="Task_Authorise">
        <dc:Bounds x="630" y="100" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InformPatient_di" bpmnElement="Task_InformPatient">
        <dc:Bounds x="880" y="100" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_StartCare_di" bpmnElement="Task_StartCare">
        <dc:Bounds x="1120" y="100" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReviewFinance_di" bpmnElement="Task_ReviewFinance">
        <dc:Bounds x="1340" y="100" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecordFinance_di" bpmnElement="Task_RecordFinance">
        <dc:Bounds x="1590" y="100" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_FollowUp_di" bpmnElement="End_FollowUp">
        <dc:Bounds x="1832" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1808" y="165" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NormalPayment_di" bpmnElement="Task_NormalPayment">
        <dc:Bounds x="630" y="330" width="210" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Normal_di" bpmnElement="End_Normal">
        <dc:Bounds x="912" y="352" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="888" y="395" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToAssess_di" bpmnElement="Flow_ToAssess">
        <di:waypoint x="196" y="220" />
        <di:waypoint x="260" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToGateway_di" bpmnElement="Flow_ToGateway">
        <di:waypoint x="440" y="220" />
        <di:waypoint x="505" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Yes_di" bpmnElement="Flow_Yes">
        <di:waypoint x="530" y="195" />
        <di:waypoint x="530" y="140" />
        <di:waypoint x="630" y="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="538" y="118" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToInform_di" bpmnElement="Flow_ToInform">
        <di:waypoint x="820" y="140" />
        <di:waypoint x="880" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToStartCare_di" bpmnElement="Flow_ToStartCare">
        <di:waypoint x="1060" y="140" />
        <di:waypoint x="1120" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToReview_di" bpmnElement="Flow_ToReview">
        <di:waypoint x="1280" y="140" />
        <di:waypoint x="1340" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToRecord_di" bpmnElement="Flow_ToRecord">
        <di:waypoint x="1530" y="140" />
        <di:waypoint x="1590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToFollowUpEnd_di" bpmnElement="Flow_ToFollowUpEnd">
        <di:waypoint x="1770" y="140" />
        <di:waypoint x="1832" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_No_di" bpmnElement="Flow_No">
        <di:waypoint x="530" y="245" />
        <di:waypoint x="530" y="370" />
        <di:waypoint x="630" y="370" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="538" y="348" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToNormalEnd_di" bpmnElement="Flow_ToNormalEnd">
        <di:waypoint x="840" y="370" />
        <di:waypoint x="912" y="370" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>