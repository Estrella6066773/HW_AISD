      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_FinanceLane_di" bpmnElement="U4_FinanceLane" isHorizontal="true">
        <dc:Bounds x="150" y="430" width="1420" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_Patient_di" bpmnElement="U4_Patient" isHorizontal="true" isExpanded="false">
