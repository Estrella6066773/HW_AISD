        <di:waypoint x="1225" y="570" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1240" y="711" width="155" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>