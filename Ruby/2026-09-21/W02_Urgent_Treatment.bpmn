        <dc:Bounds x="1085" y="490" width="175" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_RecordFinance_di" bpmnElement="U4_RecordFinance">
        <dc:Bounds x="1300" y="490" width="155" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_FollowUpEnd_di" bpmnElement="U4_FollowUpEnd">
        <dc:Bounds x="1495" y="512" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1464" y="558" width="102" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_ClinicalRule_di" bpmnElement="U4_ClinicalRule">
        <dc:Bounds x="625" y="365" width="450" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_PaymentRule_di" bpmnElement="U4_PaymentRule">
        <dc:Bounds x="220" y="610" width="780" height="45" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="U4_F1_di" bpmnElement="U4_F1">
        <di:waypoint x="246" y="300" />
        <di:waypoint x="300" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="U4_F2_di" bpmnElement="U4_F2">
        <di:waypoint x="460" y="300" />
        <di:waypoint x="515" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="U4_F3_di" bpmnElement="U4_F3">
        <di:waypoint x="565" y="300" />
        <di:waypoint x="625" y="300" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="580" y="273" width="32" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="U4_F4_di" bpmnElement="U4_F4">
