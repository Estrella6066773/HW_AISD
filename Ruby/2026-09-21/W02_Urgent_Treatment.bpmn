      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="U4_M_Notice_di" bpmnElement="U4_M_Notice">
        <di:waypoint x="945" y="260" />
        <di:waypoint x="945" y="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="960" y="114" width="160" height="34" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="U4_M_StatusRequest_di" bpmnElement="U4_M_StatusRequest">
