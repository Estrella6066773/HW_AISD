      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_RiskGateway_di" bpmnElement="U4_RiskGateway" isMarkerVisible="true">
        <dc:Bounds x="515" y="275" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="422" y="354" width="108" height="34" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_Authorise_di" bpmnElement="U4_Authorise">
        <dc:Bounds x="625" y="260" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_NotifyPatient_di" bpmnElement="U4_NotifyPatient">
        <dc:Bounds x="865" y="260" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_StartCare_di" bpmnElement="U4_StartCare">
        <dc:Bounds x="1085" y="260" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_NormalPayment_di" bpmnElement="U4_NormalPayment">
        <dc:Bounds x="620" y="490" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_NormalEnd_di" bpmnElement="U4_NormalEnd">
        <dc:Bounds x="865" y="512" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="835" y="558" width="96" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
