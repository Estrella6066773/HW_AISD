{
  "components": [
    {
      "id": "Text_Title",
      "type": "text",
      "text": "## P7 — Funding assessment\n\nChoose **Patient payment required** to call the payment worker. Amount is mandatory on that path: two decimal places, from 0.01 to 99999.99. Demo rule after a valid amount: `10.01` succeeds, `10.00` fails. A missing amount is rejected.\n\nChoose **Insurer approval recorded** only with an insurer reference.\n\n_Never enter a full card number._",
      "layout": {
        "row": "Row_Title",
        "columns": null
      }
    },
    {
      "id": "Field_patientId",
      "type": "textfield",
      "key": "patientId",
      "label": "Patient / case ID",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z][A-Za-z0-9-]{2,30}$"
      },
      "layout": {
        "row": "Row_0",
        "columns": null
      },
      "description": "Start with a letter, then letters, digits or a hyphen. Example: DEMO-001."
    },
    {
      "id": "Field_action",
      "type": "select",
      "key": "action",
      "label": "Funding outcome",
      "values": [
        {
          "label": "Hospital funding confirmed",
          "value": "hospital_funded"
        },
        {
          "label": "Insurer approval recorded",
          "value": "insurer_approved"
        },
        {
          "label": "Patient payment required - call provider",
          "value": "patient_payment_required"
        },
        {
          "label": "Payment already verified",
          "value": "patient_paid"
        },
        {
          "label": "Authorised exemption / payment arrangement",
          "value": "arrangement"
        },
        {
          "label": "Declined / incomplete / funding pending",
          "value": "pending"
        },
        {
          "label": "Provider success but confirmation missing",
          "value": "investigate"
        },
        {
          "label": "Request clinical review of urgent-care exception",
          "value": "urgent_review"
        }
      ],
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_1",
        "columns": null
      }
    },
    {
      "id": "Field_charge_amount",
      "type": "number",
      "key": "charge_amount",
      "label": "Charge amount",
      "decimalDigits": 2,
      "increment": "0.01",
      "serializeToString": true,
      "validate": {
        "required": true,
        "min": 0.01,
        "max": 99999.99
      },
      "description": "Required only for patient payment. Two decimal places, 0.01 to 99999.99. Demo: 10.01 success, 10.00 fail.",
      "conditional": {
        "hide": "=action != \"patient_payment_required\""
      },
      "layout": {
        "row": "Row_2",
        "columns": null
      }
    },
    {
      "id": "Field_insurerReference",
      "type": "textfield",
      "key": "insurerReference",
      "label": "Insurer / funding reference",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-_/]{1,39}$"
      },
      "description": "Required only when insurer approval is recorded. Letters, digits, hyphen, underscore or slash.",
      "conditional": {
        "hide": "=action != \"insurer_approved\""
      },
      "layout": {
        "row": "Row_3",
        "columns": null
      }
    },
    {
      "id": "Field_notes",
      "type": "textarea",
      "key": "notes",
      "label": "Finance notes",
      "validate": {
        "required": true,
        "minLength": 2
      },
      "layout": {
        "row": "Row_4",
        "columns": null
      }
    },
    {
      "id": "Button_Submit",
      "type": "button",
      "label": "Record funding status",
      "action": "submit",
      "layout": {
        "row": "Row_Submit",
        "columns": null
      }
    }
  ],
  "type": "default",
  "id": "funding_assessment",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  },
  "schemaVersion": 19
}
