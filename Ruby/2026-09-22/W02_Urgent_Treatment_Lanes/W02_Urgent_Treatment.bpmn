<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_UrgentTreatmentLanes" targetNamespace="http://aisd.example/student/p8" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="U4_Collaboration">
    <bpmn:participant id="U4_Hospital" name="Hospital - Urgent Treatment Without Confirmed Payment" processRef="P8_UrgentTreatmentLanes" />
    <bpmn:participant id="U4_Patient" name="Patient" />
    <bpmn:participant id="U4_PSP" name="Payment Service Provider" />
    <bpmn:messageFlow id="U4_M_Notice" name="Urgent treatment&#10;information" sourceRef="U4_NotifyPatient" targetRef="U4_Patient" />
    <bpmn:messageFlow id="U4_M_StatusRequest" name="Status enquiry&#10;(if applicable)" sourceRef="U4_ReviewFinance" targetRef="U4_PSP" />
    <bpmn:messageFlow id="U4_M_StatusReply" name="Transaction status" sourceRef="U4_PSP" targetRef="U4_ReviewFinance" />
    <bpmn:textAnnotation id="U4_ClinicalRule">
      <bpmn:text>Authorised clinician decides and records the reason.
Urgent care starts before Finance follow-up.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="U4_PaymentRule">
      <bpmn:text>Missing provider confirmation: mark for investigation.
Do not automatically request another payment.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="P8_UrgentTreatmentLanes" name="P8 Urgent Treatment Lanes" isExecutable="true">
    <bpmn:laneSet id="U4_Lanes">
      <bpmn:lane id="U4_ClinicalLane" name="Consultant / Clinical Team">
        <bpmn:flowNodeRef>U4_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U4_AssessRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U4_RiskGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U4_Authorise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U4_NotifyPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U4_StartCare</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="U4_FinanceLane" name="Finance Team">
        <bpmn:flowNodeRef>U4_NormalPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U4_NormalEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U4_ReviewFinance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U4_RecordFinance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U4_FollowUpEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="U4_Start" name="Payment unconfirmed;&#10;urgent care considered">
      <bpmn:outgoing>U4_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="U4_AssessRisk" name="Assess risk of&#10;delaying treatment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_Lane_AssessRisk" />
      </bpmn:extensionElements>
      <bpmn:incoming>U4_F1</bpmn:incoming>
      <bpmn:outgoing>U4_F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U4_RiskGateway" name="Delay risks&#10;patient safety?">
      <bpmn:incoming>U4_F2</bpmn:incoming>
      <bpmn:outgoing>U4_F3</bpmn:outgoing>
      <bpmn:outgoing>U4_F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U4_Authorise" name="Authorise urgent care&#10;and record reason">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_Lane_Authorise" />
      </bpmn:extensionElements>
      <bpmn:incoming>U4_F3</bpmn:incoming>
      <bpmn:outgoing>U4_F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="U4_NotifyPatient" name="Inform patient about&#10;urgent treatment">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>U4_F4</bpmn:incoming>
      <bpmn:outgoing>U4_F5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="U4_StartCare" name="Start urgent&#10;treatment">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>U4_F5</bpmn:incoming>
      <bpmn:outgoing>U4_F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="U4_NormalPayment" name="Return to normal funding&#10;and payment (P7)">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_Lane_NormalPayment" />
      </bpmn:extensionElements>
      <bpmn:incoming>U4_F9</bpmn:incoming>
      <bpmn:outgoing>U4_F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="U4_NormalEnd" name="Normal payment&#10;pathway">
      <bpmn:incoming>U4_F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="U4_ReviewFinance" name="Review outstanding&#10;funding / payment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_Lane_ReviewPayment" />
      </bpmn:extensionElements>
      <bpmn:incoming>U4_F6</bpmn:incoming>
      <bpmn:outgoing>U4_F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="U4_RecordFinance" name="Record follow-up&#10;and next action">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_Lane_RecordFollowUp" />
      </bpmn:extensionElements>
      <bpmn:incoming>U4_F7</bpmn:incoming>
      <bpmn:outgoing>U4_F8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="U4_FollowUpEnd" name="Finance follow-up&#10;recorded">
      <bpmn:incoming>U4_F8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="U4_F1" sourceRef="U4_Start" targetRef="U4_AssessRisk" />
    <bpmn:sequenceFlow id="U4_F2" sourceRef="U4_AssessRisk" targetRef="U4_RiskGateway" />
    <bpmn:sequenceFlow id="U4_F3" name="Yes" sourceRef="U4_RiskGateway" targetRef="U4_Authorise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=delayRisksSafety = "Yes"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="U4_F4" sourceRef="U4_Authorise" targetRef="U4_NotifyPatient" />
    <bpmn:sequenceFlow id="U4_F5" sourceRef="U4_NotifyPatient" targetRef="U4_StartCare" />
    <bpmn:sequenceFlow id="U4_F6" sourceRef="U4_StartCare" targetRef="U4_ReviewFinance" />
    <bpmn:sequenceFlow id="U4_F7" sourceRef="U4_ReviewFinance" targetRef="U4_RecordFinance" />
    <bpmn:sequenceFlow id="U4_F8" sourceRef="U4_RecordFinance" targetRef="U4_FollowUpEnd" />
    <bpmn:sequenceFlow id="U4_F9" name="No" sourceRef="U4_RiskGateway" targetRef="U4_NormalPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=delayRisksSafety = "No"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="U4_F10" sourceRef="U4_NormalPayment" targetRef="U4_NormalEnd" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="U4_Diagram">
    <bpmndi:BPMNPlane id="U4_Plane" bpmnElement="U4_Collaboration">
      <bpmndi:BPMNShape id="U4_Patient_di" bpmnElement="U4_Patient" isHorizontal="true" isExpanded="false">
        <dc:Bounds x="120" y="0" width="1450" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_Hospital_di" bpmnElement="U4_Hospital" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1450" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_PSP_di" bpmnElement="U4_PSP" isHorizontal="true" isExpanded="false">
        <dc:Bounds x="120" y="640" width="1450" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_FinanceLane_di" bpmnElement="U4_FinanceLane" isHorizontal="true">
        <dc:Bounds x="150" y="330" width="1420" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_ClinicalLane_di" bpmnElement="U4_ClinicalLane" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1420" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_Start_di" bpmnElement="U4_Start">
        <dc:Bounds x="210" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="175" y="216" width="115" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_AssessRisk_di" bpmnElement="U4_AssessRisk">
        <dc:Bounds x="300" y="150" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_RiskGateway_di" bpmnElement="U4_RiskGateway" isMarkerVisible="true">
        <dc:Bounds x="515" y="165" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="504" y="116" width="72" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_Authorise_di" bpmnElement="U4_Authorise">
        <dc:Bounds x="625" y="150" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_NotifyPatient_di" bpmnElement="U4_NotifyPatient">
        <dc:Bounds x="865" y="150" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_StartCare_di" bpmnElement="U4_StartCare">
        <dc:Bounds x="1085" y="150" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_NormalPayment_di" bpmnElement="U4_NormalPayment">
        <dc:Bounds x="620" y="400" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_NormalEnd_di" bpmnElement="U4_NormalEnd">
        <dc:Bounds x="865" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="835" y="466" width="96" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_ReviewFinance_di" bpmnElement="U4_ReviewFinance">
        <dc:Bounds x="1085" y="400" width="175" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_RecordFinance_di" bpmnElement="U4_RecordFinance">
        <dc:Bounds x="1300" y="400" width="155" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_FollowUpEnd_di" bpmnElement="U4_FollowUpEnd">
        <dc:Bounds x="1495" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1464" y="466" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="U4_F1_di" bpmnElement="U4_F1">
        <di:waypoint x="246" y="190" />
        <di:waypoint x="300" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="U4_F2_di" bpmnElement="U4_F2">
        <di:waypoint x="460" y="190" />
        <di:waypoint x="515" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="U4_F3_di" bpmnElement="U4_F3">
        <di:waypoint x="565" y="190" />
        <di:waypoint x="625" y="190" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="580" y="172" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="U4_F4_di" bpmnElement="U4_F4">
        <di:waypoint x="805" y="190" />
        <di:waypoint x="865" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="U4_F5_di" bpmnElement="U4_F5">
        <di:waypoint x="1025" y="190" />
        <di:waypoint x="1085" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="U4_F6_di" bpmnElement="U4_F6">
        <di:waypoint x="1170" y="230" />
        <di:waypoint x="1170" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="U4_F7_di" bpmnElement="U4_F7">
        <di:waypoint x="1260" y="440" />
        <di:waypoint x="1300" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="U4_F8_di" bpmnElement="U4_F8">
        <di:waypoint x="1455" y="440" />
        <di:waypoint x="1495" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="U4_F9_di" bpmnElement="U4_F9">
        <di:waypoint x="540" y="215" />
        <di:waypoint x="540" y="440" />
        <di:waypoint x="620" y="440" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="548" y="320" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="U4_F10_di" bpmnElement="U4_F10">
        <di:waypoint x="810" y="440" />
        <di:waypoint x="865" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="U4_ClinicalRule_di" bpmnElement="U4_ClinicalRule">
        <dc:Bounds x="625" y="250" width="450" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U4_PaymentRule_di" bpmnElement="U4_PaymentRule">
        <dc:Bounds x="220" y="520" width="780" height="45" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="U4_M_Notice_di" bpmnElement="U4_M_Notice">
        <di:waypoint x="945" y="150" />
        <di:waypoint x="945" y="60" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="960" y="90" width="150" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="U4_M_StatusRequest_di" bpmnElement="U4_M_StatusRequest">
        <di:waypoint x="1140" y="480" />
        <di:waypoint x="1140" y="640" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="980" y="545" width="140" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="U4_M_StatusReply_di" bpmnElement="U4_M_StatusReply">
        <di:waypoint x="1220" y="640" />
        <di:waypoint x="1220" y="480" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1230" y="545" width="110" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
