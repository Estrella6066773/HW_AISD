<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Student" targetNamespace="http://aisd.example/student" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:collaboration id="Collaboration_Student">
    <bpmn:participant id="Hospital" name="Hospital - Referral Review and First Appointment" processRef="Process_Student" />
    <bpmn:participant id="Patient" name="Patient" />
    <bpmn:participant id="ReferringOrganisation" name="Referring Organisation (GP / Other Hospital)" />
    <bpmn:messageFlow id="Message_AppointmentLetter" name="Appointment letter" sourceRef="Letter" targetRef="Patient" />
    <bpmn:messageFlow id="Message_TelephoneContact" name="Telephone contact attempt" sourceRef="Call" targetRef="Patient" />
    <bpmn:messageFlow id="MF_Referral" name="Referral documents" sourceRef="ReferringOrganisation" targetRef="Start" />
    <bpmn:messageFlow id="MF_InfoRequest" name="Request for further information" sourceRef="MoreInfo" targetRef="ReferringOrganisation" />
    <bpmn:messageFlow id="MF_InfoResponse" name="Further information" sourceRef="ReferringOrganisation" targetRef="InfoReceived" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Student" name="Referral Review and First Appointment - Simple Collaboration" isExecutable="false">
    <bpmn:documentation>Simple conceptual collaboration based on the supplied hospital case study. Referring Organisation represents a GP or another hospital; Patient is a separate participant. Both external participants are black-box pools. Hospital roles remain lanes within one hospital process. The message start event receives referral documents. The Consultant alone makes and records the clinical referral decision; secretaries check and complete supporting information. Check / complete referral documents abstracts initial missing-document collection. Modelling assumption: the further-information branch requested by the Consultant is routed by the secretaries to the referring organisation, based on the explicit missing-information rule in paragraph 3; paragraph 4 does not prescribe every source of further information. Information received refers to the external reply, not an internal hospital message. Appointment-letter delivery abstracts the external correspondence service; booking abstracts the external scheduling service. Telephone contact represents an attempt and does not guarantee an answer; the outcome is recorded. An appointment within the following two weeks also requires telephone contact. No-slot cases, urgent referrals, alternative appointment requests and detailed contact failures are outside this simple main-flow view. External scheduling, correspondence and destination specialist-service details are not expanded here. This is a conceptual model and is not configured for execution.</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_Bookings" name="Outpatient Bookings Team">
        <bpmn:flowNodeRef>Book</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TwoWeeks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Consultant" name="Consultant">
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RejectEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Redirect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RedirectEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Secretary" name="Medical Secretaries">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InfoReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MoreInfo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Referral received">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ReferralStart_Definition" messageRef="Message_Referral" />
    </bpmn:startEvent>
    <bpmn:userTask id="Check" name="Check / complete&#10;referral documents">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="InfoReceived" name="Information received">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="InfoReceived_Definition" messageRef="Message_FurtherInfo" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Review" name="Review referral and&#10;record decision">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Decision" name="Decision?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="RejectEnd" name="Rejected">
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Redirect" name="Redirect referral">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="RedirectEnd" name="Redirected">
      <bpmn:incoming>F8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Book" name="Book and confirm&#10;appointment">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Letter" name="Send appointment&#10;letter">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="TwoWeeks" name="Within two&#10;weeks?">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Call" name="Call patient and&#10;record outcome">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Done" name="Finished">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Check" />
    <bpmn:sequenceFlow id="F5" sourceRef="MoreInfo" targetRef="InfoReceived" />
    <bpmn:sequenceFlow id="F2" sourceRef="Check" targetRef="Review" />
    <bpmn:sequenceFlow id="F4" name="More information" sourceRef="Decision" targetRef="MoreInfo" />
    <bpmn:sequenceFlow id="F3" sourceRef="Review" targetRef="Decision" />
    <bpmn:sequenceFlow id="F6" name="Reject" sourceRef="Decision" targetRef="RejectEnd" />
    <bpmn:sequenceFlow id="F7" name="Redirect" sourceRef="Decision" targetRef="Redirect" />
    <bpmn:sequenceFlow id="F9" name="Accept" sourceRef="Decision" targetRef="Book" />
    <bpmn:sequenceFlow id="F8" sourceRef="Redirect" targetRef="RedirectEnd" />
    <bpmn:sequenceFlow id="F10" sourceRef="Book" targetRef="Letter" />
    <bpmn:sequenceFlow id="F11" sourceRef="Letter" targetRef="TwoWeeks" />
    <bpmn:sequenceFlow id="F12" name="No" sourceRef="TwoWeeks" targetRef="Done" />
    <bpmn:sequenceFlow id="F13" name="Yes" sourceRef="TwoWeeks" targetRef="Call" />
    <bpmn:sequenceFlow id="F14" sourceRef="Call" targetRef="Done" />
    <bpmn:sequenceFlow id="F15" sourceRef="InfoReceived" targetRef="Check" />
    <bpmn:sendTask id="MoreInfo" name="Request further&#10;information" messageRef="Message_InfoRequest">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:sendTask>
  </bpmn:process>
  <bpmn:message id="Message_FurtherInfo" name="Further information received" />
  <bpmn:message id="Message_Referral" name="Referral documents" />
  <bpmn:message id="Message_InfoRequest" name="Request for further information" />
  <bpmndi:BPMNDiagram id="Diagram_Student">
