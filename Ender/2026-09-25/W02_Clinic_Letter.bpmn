      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ClinicalError_di" bpmnElement="ClinicalError" isMarkerVisible="true">
        <dc:Bounds x="825" y="328" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="790" y="400" width="125" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendLetter_di" bpmnElement="SendLetter">
        <dc:Bounds x="955" y="315" width="160" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RecordDispatch_di" bpmnElement="RecordDispatch">
        <dc:Bounds x="1175" y="315" width="160" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LetterSent_di" bpmnElement="LetterSent">
        <dc:Bounds x="1440" y="335" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1411" y="389" width="96" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SevenDays_di" bpmnElement="SevenDays">
        <dc:Bounds x="950" y="135" width="485" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Letter_Correspondence_di" bpmnElement="Letter_Correspondence" isHorizontal="true" isExpanded="false">
        <dc:Bounds x="120" y="575" width="1460" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Letter_Patient_di" bpmnElement="Letter_Patient" isHorizontal="true" isExpanded="false">
        <dc:Bounds x="120" y="765" width="650" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Letter_ClinicalRecipient_di" bpmnElement="Letter_ClinicalRecipient" isHorizontal="true" isExpanded="false">
        <dc:Bounds x="930" y="765" width="650" height="60" />
      </bpmndi:BPMNShape>
