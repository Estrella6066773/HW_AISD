        <bpmndi:BPMNLabel>
          <dc:Bounds x="902" y="326" width="32" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="LF7_di" bpmnElement="LF7">
        <di:waypoint x="1115" y="353" />
        <di:waypoint x="1175" y="353" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="LF8_di" bpmnElement="LF8">
