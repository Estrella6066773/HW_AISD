        <dc:Bounds x="870" y="827" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AuthoriseChange_di" bpmnElement="AuthoriseChange">
        <dc:Bounds x="1460" y="350" width="200" height="70" />
