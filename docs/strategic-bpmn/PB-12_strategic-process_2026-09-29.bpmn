      <bpmndi:BPMNShape id="GW_Money_di" bpmnElement="GW_Money" isMarkerVisible="true">
        <dc:Bounds x="1700" y="360" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Change_di" bpmnElement="End_Change">
        <dc:Bounds x="1800" y="367" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReviewMoney_di" bpmnElement="ReviewMoney">
        <dc:Bounds x="2060" y="800" width="230" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Money_di" bpmnElement="End_Money">
        <dc:Bounds x="2330" y="817" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_Strategic_di" bpmnElement="Note_Strategic">
        <dc:Bounds x="80" y="1200" width="720" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_di" bpmnElement="Flow_Start">
        <di:waypoint x="176" y="540" />
        <di:waypoint x="220" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Referral_di" bpmnElement="Flow_Referral">
        <di:waypoint x="270" y="540" />
        <di:waypoint x="320" y="535" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="295" y="520" width="80" height="14" />
