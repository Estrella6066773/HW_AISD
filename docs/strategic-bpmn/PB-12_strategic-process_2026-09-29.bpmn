<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_PB12_Strategic" targetNamespace="https://aisd.example/hospital/strategic" exporter="PB-12 strategic model" exporterVersion="2026-09-29" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_Strategic">
    <bpmn:participant id="Hospital" name="Hospital" processRef="Strategic_Hospital_Pathway" />
    <bpmn:participant id="Referrer" name="Referring organisation" />
    <bpmn:participant id="Scheduler" name="External scheduling service" />
    <bpmn:participant id="CareServices" name="External treatment, laboratory and imaging" />
    <bpmn:participant id="Funder" name="Insurer or funding organisation" />
    <bpmn:participant id="PaymentProvider" name="External payment service provider" />
    <bpmn:participant id="Patient" name="Patient or authorised representative" />
    <bpmn:messageFlow id="Msg_ReferralIn" name="Referral documents" sourceRef="Referrer" targetRef="CheckDocuments" />
    <bpmn:messageFlow id="Msg_Missing" name="Request for missing documents" sourceRef="CheckDocuments" targetRef="Referrer" />
    <bpmn:messageFlow id="Msg_Closed" name="Rejection or redirect notice" sourceRef="CloseReferral" targetRef="Referrer" />
    <bpmn:messageFlow id="Msg_SlotOut" name="Slot request inside the clinical window" sourceRef="BookAppointment" targetRef="Scheduler" />
    <bpmn:messageFlow id="Msg_SlotIn" name="Slot offered, or no suitable slot" sourceRef="Scheduler" targetRef="BookAppointment" />
    <bpmn:messageFlow id="Msg_NotifyPatient" name="Appointment letter; telephone as well when the visit is within two weeks" sourceRef="BookAppointment" targetRef="Patient" />
    <bpmn:messageFlow id="Msg_ResourceOut" name="Treatment, laboratory or imaging request" sourceRef="CoordinateResources" targetRef="CareServices" />
    <bpmn:messageFlow id="Msg_ResourceIn" name="Available, or unavailable and still pending" sourceRef="CareServices" targetRef="CoordinateResources" />
    <bpmn:messageFlow id="Msg_FundOut" name="Funding approval request" sourceRef="DetermineFunding" targetRef="Funder" />
    <bpmn:messageFlow id="Msg_FundIn" name="Organisation, reference, amount and limits" sourceRef="Funder" targetRef="DetermineFunding" />
    <bpmn:messageFlow id="Msg_PayOut" name="Payment or refund request, without the card number" sourceRef="DetermineFunding" targetRef="PaymentProvider" />
    <bpmn:messageFlow id="Msg_PayIn" name="Status, reference, date and amount" sourceRef="PaymentProvider" targetRef="DetermineFunding" />
    <bpmn:messageFlow id="Msg_LetterPatient" name="Approved clinic letter" sourceRef="DispatchLetter" targetRef="Patient" />
    <bpmn:messageFlow id="Msg_LetterReferrer" name="Clinic letter for the referring clinician" sourceRef="DispatchLetter" targetRef="Referrer" />
    <bpmn:messageFlow id="Msg_ClinReply" name="Clinical response from an authorised clinician" sourceRef="AnswerClinical" targetRef="Patient" />
    <bpmn:messageFlow id="Msg_FinReply" name="Funding or payment response" sourceRef="AnswerFinance" targetRef="Patient" />
    <bpmn:messageFlow id="Msg_AdminReply" name="Administrative response" sourceRef="RouteEnquiry" targetRef="Patient" />
    <bpmn:textAnnotation id="Note_Strategic">
      <bpmn:text>STRATEGIC MODEL for the initial release. This diagram is not executable and has no Camunda forms or job workers. Each task is one business stage. The operational model Hospital_All_Processes_Simple_C8 expands the stages into user tasks, gateways and workers. Read docs/strategic-bpmn/PB-12_abstraction-level_2026-09-29.md for the abstraction level, the mapping, and the gaps.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note" sourceRef="Hospital" targetRef="Note_Strategic" />
  </bpmn:collaboration>
  <bpmn:process id="Strategic_Hospital_Pathway" name="Hospital patient pathway (strategic)" isExecutable="false">
    <bpmn:documentation>PB-12 strategic BPMN. Not for deployment. Lanes separate clinical decisions, administrative coordination and finance decisions. Black-box pools are the referring organisation, the patient, and the external scheduling, care-resource, funding and payment participants. The opening gateway is the same business choice as the operational RequestType gateway, collapsed to three incoming kinds: referral, enquiry, and change or follow-up.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Strategic">
      <bpmn:lane id="Lane_Clinical" name="Clinical team">
        <bpmn:flowNodeRef>DecideReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Treatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AuthoriseTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WriteLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AnswerClinical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ClinicalEnquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AuthoriseChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Money</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Change</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin" name="Administration">
        <bpmn:flowNodeRef>Start_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Kind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CloseReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BookAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_AfterVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CoordinateResources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Treatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DispatchLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Main</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RouteEnquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Enquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AdminEnquiry</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance">
        <bpmn:flowNodeRef>DetermineFunding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AnswerFinance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_FinanceEnquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReviewMoney</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Money</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Request" name="Request arrives" />
    <bpmn:exclusiveGateway id="GW_Kind" name="Incoming request" default="Flow_Referral" />
    <bpmn:task id="CheckDocuments" name="Check referral documents">
      <bpmn:documentation>Medical secretaries check previous clinic letters, investigation results and other clinical documents. They may ask the referring organisation for missing items. They do not judge clinical suitability and they do not accept the referral. Operational model: Register, GetDocuments.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="DecideReferral" name="Record the clinical decision">
      <bpmn:documentation>The consultant accepts, rejects, asks for further information, or redirects to another speciality, and records the reason and who decided. Operational model: ReviewReferral, ReferralDecision, Redirect.</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Accepted" name="Clinical decision" default="Flow_Accepted" />
    <bpmn:task id="CloseReferral" name="Notify the referrer and close">
      <bpmn:documentation>Administration tells the referring organisation that the referral was rejected or redirected. No first clinic appointment is created. Operational model: Redirect, EndRejected.</bpmn:documentation>
    </bpmn:task>
    <bpmn:endEvent id="End_Closed" name="Referral closed" />
    <bpmn:task id="BookAppointment" name="Book the first appointment and notify the patient">
      <bpmn:documentation>Only after acceptance, outpatient bookings ask the external scheduling service for a slot inside the consultant's window, confirm it in the hospital, and notify the patient. A visit within two weeks also needs a telephone attempt and a recorded outcome. No suitable slot stays pending for the pathway team. Operational model: BookVisit, CheckVisitSlot, send-booking-confirmation.</bpmn:documentation>
    </bpmn:task>
    <bpmn:parallelGateway id="GW_AfterVisit" name="Attendance recorded" />
    <bpmn:exclusiveGateway id="GW_Treatment" name="After the consultation" default="Flow_Treat" />
    <bpmn:task id="AuthoriseTreatment" name="Authorise the treatment booking">
      <bpmn:documentation>After the patient agrees, the consultant records consent and creates the treatment booking request. Administrative staff cannot continue an unauthorised request. Operational model: ClinicalCare.</bpmn:documentation>
    </bpmn:task>
    <bpmn:endEvent id="End_NoTreatment" name="No further treatment" />
    <bpmn:task id="DetermineFunding" name="Determine funding and payment">
      <bpmn:documentation>Finance decides whether the hospital, an insurer or funding organisation, or the patient pays, then requests payment or records an approval. The card number is not stored. A missing confirmation is investigated and is not charged again automatically. Urgent care can proceed only with a recorded clinical reason and a later finance follow-up. Operational model: Funding, RequestPayment, PaymentReceived, FundingIssue, UrgentAuthorisation, mark-payment-investigate.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="CoordinateResources" name="Confirm external treatment resources">
      <bpmn:documentation>Treatment bookings confirm external treatment, laboratory or imaging only after funding or payment allows confirmation. An unavailable service stays pending, the responsible team is told, and the same request is not booked twice. Operational model: BookTreatment, FlagResourceUnavailable, reserve-appointment.</bpmn:documentation>
    </bpmn:task>
    <bpmn:endEvent id="End_Treatment" name="Treatment booking recorded" />
    <bpmn:task id="WriteLetter" name="Write and approve the clinic letter">
      <bpmn:documentation>The consultant writes the clinic letter and approves it before anyone distributes it. Operational model: ClinicalCare letter fields, letterStatus.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="DispatchLetter" name="Distribute the approved clinic letter">
      <bpmn:documentation>Medical secretaries distribute the approved letter. They may correct formatting and administrative errors only. Past seven days is delayed; about one month and three months escalate. Reminders stop once the letter is complete. The classroom operational model records the time band on a user task and does not run a multi-day timer. Operational model: DispatchLetter, DispatchClinicLetter, MonitorLetters.</bpmn:documentation>
    </bpmn:task>
    <bpmn:endEvent id="End_Main" name="Letter sent" />
    <bpmn:task id="RouteEnquiry" name="Log the enquiry and route it">
      <bpmn:documentation>Call handling logs the enquiry and classifies it as administrative, financial or clinical. Call handlers answer administrative questions only. Operational model: AdminEnquiry.</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Enquiry" name="Enquiry class" default="Flow_EnqAdmin" />
    <bpmn:endEvent id="End_AdminEnquiry" name="Administrative enquiry closed" />
    <bpmn:task id="AnswerClinical" name="Answer the clinical enquiry">
      <bpmn:documentation>A clinical nurse specialist or another authorised clinician answers a clinical enquiry. Call handlers do not diagnose, interpret results or recommend treatment. Operational model: ClinicalEnquiry.</bpmn:documentation>
    </bpmn:task>
    <bpmn:endEvent id="End_ClinicalEnquiry" name="Clinical enquiry closed" />
    <bpmn:task id="AnswerFinance" name="Answer the funding enquiry">
      <bpmn:documentation>Finance answers payment and funding enquiries. Operational model: FinanceEnquiry.</bpmn:documentation>
    </bpmn:task>
    <bpmn:endEvent id="End_FinanceEnquiry" name="Funding enquiry closed" />
    <bpmn:task id="AuthoriseChange" name="Authorise the change or follow-up">
      <bpmn:documentation>Clinical staff submit a formal request before a treatment change, cancellation, postponement or follow-up. Telephone, email or a verbal request is not enough. An urgent stop for safety can happen first, with authorisation recorded afterwards. Operational model: ClinicalChange, notify-care-change.</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Money" name="Money affected?" default="Flow_MoneyNo" />
    <bpmn:endEvent id="End_Change" name="Change recorded" />
    <bpmn:task id="ReviewMoney" name="Review the refund or retained payment">
      <bpmn:documentation>Finance, not the consultant, decides a refund, transfer or retention when a change affects a charge, an approval or a completed payment. Operational model: FinanceAdjustment, request-refund.</bpmn:documentation>
    </bpmn:task>
    <bpmn:endEvent id="End_Money" name="Financial review recorded" />
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Start_Request" targetRef="GW_Kind" />
    <bpmn:sequenceFlow id="Flow_Referral" name="Referral" sourceRef="GW_Kind" targetRef="CheckDocuments" />
    <bpmn:sequenceFlow id="Flow_Enquiry" name="Enquiry" sourceRef="GW_Kind" targetRef="RouteEnquiry" />
    <bpmn:sequenceFlow id="Flow_Change" name="Change or follow-up" sourceRef="GW_Kind" targetRef="AuthoriseChange" />
    <bpmn:sequenceFlow id="Flow_Checked" sourceRef="CheckDocuments" targetRef="DecideReferral" />
    <bpmn:sequenceFlow id="Flow_Decided" sourceRef="DecideReferral" targetRef="GW_Accepted" />
    <bpmn:sequenceFlow id="Flow_MoreInfo" name="More information" sourceRef="GW_Accepted" targetRef="CheckDocuments" />
    <bpmn:sequenceFlow id="Flow_NotAccepted" name="Not accepted" sourceRef="GW_Accepted" targetRef="CloseReferral" />
    <bpmn:sequenceFlow id="Flow_Closed" sourceRef="CloseReferral" targetRef="End_Closed" />
    <bpmn:sequenceFlow id="Flow_Accepted" name="Accepted" sourceRef="GW_Accepted" targetRef="BookAppointment" />
    <bpmn:sequenceFlow id="Flow_Booked" sourceRef="BookAppointment" targetRef="GW_AfterVisit" />
    <bpmn:sequenceFlow id="Flow_ToCare" name="Care plan" sourceRef="GW_AfterVisit" targetRef="GW_Treatment" />
    <bpmn:sequenceFlow id="Flow_ToLetter" name="Clinic letter" sourceRef="GW_AfterVisit" targetRef="WriteLetter" />
    <bpmn:sequenceFlow id="Flow_Treat" name="Treatment agreed" sourceRef="GW_Treatment" targetRef="AuthoriseTreatment" />
    <bpmn:sequenceFlow id="Flow_NoTreat" name="No further treatment" sourceRef="GW_Treatment" targetRef="End_NoTreatment" />
    <bpmn:sequenceFlow id="Flow_Authorised" sourceRef="AuthoriseTreatment" targetRef="DetermineFunding" />
    <bpmn:sequenceFlow id="Flow_Funded" sourceRef="DetermineFunding" targetRef="CoordinateResources" />
    <bpmn:sequenceFlow id="Flow_Coordinated" sourceRef="CoordinateResources" targetRef="End_Treatment" />
    <bpmn:sequenceFlow id="Flow_Letter" sourceRef="WriteLetter" targetRef="DispatchLetter" />
    <bpmn:sequenceFlow id="Flow_Dispatched" sourceRef="DispatchLetter" targetRef="End_Main" />
    <bpmn:sequenceFlow id="Flow_Routed" sourceRef="RouteEnquiry" targetRef="GW_Enquiry" />
    <bpmn:sequenceFlow id="Flow_EnqAdmin" name="Administrative" sourceRef="GW_Enquiry" targetRef="End_AdminEnquiry" />
    <bpmn:sequenceFlow id="Flow_EnqClinical" name="Clinical" sourceRef="GW_Enquiry" targetRef="AnswerClinical" />
    <bpmn:sequenceFlow id="Flow_EnqFinance" name="Financial" sourceRef="GW_Enquiry" targetRef="AnswerFinance" />
    <bpmn:sequenceFlow id="Flow_ClinDone" sourceRef="AnswerClinical" targetRef="End_ClinicalEnquiry" />
    <bpmn:sequenceFlow id="Flow_FinDone" sourceRef="AnswerFinance" targetRef="End_FinanceEnquiry" />
    <bpmn:sequenceFlow id="Flow_Changed" sourceRef="AuthoriseChange" targetRef="GW_Money" />
    <bpmn:sequenceFlow id="Flow_MoneyYes" name="Charge, approval or payment affected" sourceRef="GW_Money" targetRef="ReviewMoney" />
    <bpmn:sequenceFlow id="Flow_MoneyNo" name="No financial impact" sourceRef="GW_Money" targetRef="End_Change" />
    <bpmn:sequenceFlow id="Flow_MoneyDone" sourceRef="ReviewMoney" targetRef="End_Money" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Strategic">
    <bpmndi:BPMNPlane id="Plane_Strategic" bpmnElement="Collaboration_Strategic">
      <bpmndi:BPMNShape id="Hospital_di" bpmnElement="Hospital">
